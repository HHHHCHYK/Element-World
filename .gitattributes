#
# https://help.github.com/articles/dealing-with-line-endings/
#

# 默认：所有文本文件自动转换换行符（仓库内统一 LF）
* text=auto eol=lf

# 这些脚本需要明确的换行符
/gradlew        text eol=lf
*.bat           text eol=crlf

# 这些文本文件统一用 LF
*.java          text eol=lf
*.json          text eol=lf
*.gradle        text eol=lf
*.properties    text eol=lf
*.md            text eol=lf
*.toml          text eol=lf
*.mixins.json   text eol=lf

# 二进制资源：标记为 binary，禁止 git 做换行符/合并处理
*.png           binary
*.jpg           binary
*.jpeg          binary
*.gif           binary
*.webp          binary
*.ico           binary
*.ogg           binary
*.wav           binary
*.mp3           binary
*.nbt           binary

# Gradle Wrapper jar 应作为二进制纳入版本控制
gradle-wrapper.jar binary
